NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Include the database name in the URI
# or set MONGODB_DB_NAME explicitly.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/office_visitor_management?retryWrites=true&w=majority
MONGODB_DB_NAME=office_visitor_management

# Better Auth (generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (redirect URI: http://localhost:5000/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Visitor passes
PASS_DEFAULT_VALIDITY_HOURS=8

# Seed script (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Administrator

